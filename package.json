  "homepage": "https://github.com/bahriy-dev/turkish-id-validation-api#readme",
  "bugs": "https://github.com/bahriy-dev/turkish-id-validation-api/issues",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "npx -y -p typescript@5.9 tsc --noEmit"
